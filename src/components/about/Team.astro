---
const team = [
  {
    name: 'Crystal McGuinn',
    image: '/assets/crystal.webp',
    job: 'Owner & Professional Painter',
  },
];
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="sm:space-8 space-y-12">
      <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">Meet the Professional</h2>
      <div class="flex justify-center">
        {
          team.map((item) => (
            <div class="border-md-outline-variant rounded-3xl border px-8 py-10 max-w-md">
              <div class="space-y-8 text-center">
                <img class="mx-auto h-32 w-32 rounded-full object-cover" src={item.image} alt={item.name} />
                <div>
                  <h3 class="text-2xl font-medium">{item.name}</h3>
                  <p class="text-md-on-surface-variant text-lg mt-2">{item.job}</p>
                  <p class="text-md-on-surface-variant text-base mt-4">
                    Over 30 years of experience in professional painting, cleaning, and flooring installation
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

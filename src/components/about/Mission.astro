---
const stats = [
  {
    name: 'Years of Experience',
    value: '30+',
  },
  {
    name: 'Happy Clients',
    value: '500+',
  },
  {
    name: 'Projects Completed',
    value: '1000+',
  },
  {
    name: 'Services Offered',
    value: '3',
  },
];
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="grid gap-16 lg:grid-cols-2 lg:gap-24">
      <img
        class="mx-auto h-auto w-full max-w-xl rounded-3xl"
        width="576"
        height="864"
        src="/assets/1.webp"
        alt="Professional painting and cleaning work"
      />
      <div class="flex flex-col gap-10">
        <!-- Mission description -->
        <div class="space-y-8 sm:space-y-12">
          <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">Our Mission</h2>
          <div class="space-y-6">
            <p class="text-md-on-surface-variant text-base sm:text-lg">
              At Crystal's Cleaning and Painting, our mission is to transform spaces and exceed expectations. With over 30 years of experience, Crystal McGuinn has built a reputation for excellence, attention to detail, and unwavering commitment to quality.
            </p>
            <p class="text-md-on-surface-variant text-base sm:text-lg">
              Whether it's a fresh coat of paint that brings new life to your walls, deep cleaning that restores your space's sparkle, or professional flooring installation that enhances your home or business, we approach every project with the same dedication and expertise.
            </p>
           
          </div>
        </div>

        <!-- Stats -->
        <dl class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          {
            stats.map((stat) => (
              <div class="border-md-outline-variant rounded-3xl border p-6">
                <dt class="text-base">{stat.name}</dt>
                <dd class="text-3xl font-medium tracking-tight">{stat.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

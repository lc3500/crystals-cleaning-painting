---
const values = [
  [
    {
      ref: '01',
      name: 'Quality Craftsmanship',
      description:
        'Every project, whether big or small, receives the same level of meticulous attention to detail. We take pride in delivering flawless results that stand the test of time, using only the highest quality materials and proven techniques.',
    },
    {
      ref: '02',
      name: 'Customer First',
      description:
        'Your satisfaction is our top priority. We listen to your needs, respect your space, and work diligently to bring your vision to life. Clear communication and personalized service are at the heart of everything we do.',
    },
  ],
  [
    {
      ref: '03',
      name: 'Local & Reliable',
      description:
        'Based in Marion, IN, we\'re part of your community. We understand local needs and take pride in serving our neighbors with dependable, professional service. When you call Crystal\'s Cleaning and Painting, you can count on us to show up on time and get the job done right.',
    },
    {
      ref: '04',
      name: 'Experience & Expertise',
      description:
        'With over 30 years in the industry, Crystal brings unmatched knowledge and skill to every project. This wealth of experience means we can handle any challenge and deliver results that exceed expectations.',
    },
  ],
];
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="flex flex-col gap-8 lg:gap-12">
      <h2 class="text-3xl font-medium tracking-tight sm:text-4xl">Our Values</h2>
      <div class="grid gap-8 lg:grid-cols-2">
        {
          values.map((column, index) => (
            <div class:list={['space-y-8', index === 1 && 'lg:mt-16']}>
              {column.map((value) => (
                <div class="bg-md-surface-container flex flex-col gap-12 rounded-3xl px-6 py-8">
                  <p class="text-sm">{value.ref}</p>
                  <div class="flex flex-col gap-4">
                    <h3 class="text-xl font-medium">{value.name}</h3>
                    <p class="text-md-on-surface-variant text-base sm:text-lg">
                      {value.description}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

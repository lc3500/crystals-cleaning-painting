---
const testimonials = [
  {
    name: 'Sarah Johnson',
    description: 'Homeowner',
    image: '/assets/testimonial-1.webp',
    message:
      '"Crystal did an amazing job painting our living room and kitchen. Her attention to detail was incredible, and she was professional throughout the entire project. Highly recommend!"',
  },
  {
    name: 'Mike Patterson',
    description: 'Business Owner',
    image: '/assets/testimonial-2.webp',
    message:
      '"We hired Crystal for a complete office cleaning and painting refresh. The results exceeded our expectations. She is reliable, skilled, and takes pride in her work."',
  },
  {
    name: 'Jennifer Davis',
    description: 'Marion Resident',
    image: '/assets/testimonial-3.webp',
    message:
      '"After 30 years in business, Crystal knows her craft inside and out. The flooring installation she did in our home looks beautiful, and her cleaning service is top-notch."',
  },
];
---

<section class="py-16 sm:py-20">
  <div class="v mx-auto px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="flex flex-col items-center gap-12 lg:gap-20">
      <h2 class="mx-auto max-w-xl text-center text-3xl font-medium tracking-tight sm:text-4xl">
        What Our Clients Say
      </h2>
      <div
        class="divide-md-outline-variant grid divide-y lg:grid-cols-3 lg:divide-x lg:divide-y-0"
      >
        {
          testimonials.map((testimonial) => (
            <figure class="mx-auto flex max-w-lg flex-col items-center gap-6 py-8 lg:px-8 lg:py-0">
              <div class="flex flex-row gap-2">
                {[...Array(5)].map(() => (
                  <svg
                    class="text-md-tertiary h-6 w-6"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12.0006 18.26L4.94715 22.2082L6.52248 14.2799L0.587891 8.7918L8.61493 7.84006L12.0006 0.5L15.3862 7.84006L23.4132 8.7918L17.4787 14.2799L19.054 22.2082L12.0006 18.26Z" />
                  </svg>
                ))}
              </div>
              <blockquote class="text-md-on-surface-variant text-center text-lg italic leading-loose">
                <p>{testimonial.message}</p>
              </blockquote>
              <figcaption class="flex flex-col gap-4">
                <img class="mx-auto h-8 w-8 rounded-full" src={testimonial.image} alt="" />
                <div class="text-center">
                  <div class="text-base font-medium">{testimonial.name}</div>
                  <div class="text-md-on-surface-variant text-sm">
                    {testimonial.description}
                  </div>
                </div>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>
